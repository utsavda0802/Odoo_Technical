<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gst_form_form" model="ir.ui.view">
        <field name="name">gst.form.form</field>
        <field name="model">gst.form</field>
        <field name="arch" type="xml">
            <form string="GST Form">
                <group>
                    <field name="name"/>
                    <field name="purchase_order_id"/>
                    <field name="applicable_amount"/>
                    <field name="gst_percentage"/>
                    <field name="gst_amount"/>
                    <field name="old_gst_amount"/>
                    <field name="new_gst_amount"/>
                    <field name="gst_difference"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_gst_form_list" model="ir.ui.view">
        <field name="name">gst.form.list</field>
        <field name="model">gst.form</field>
        <field name="arch" type="xml">
            <list string="GST Forms">
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="gst_percentage"/>
                <field name="gst_amount"/>
            </list>
        </field>
    </record>

    <record id="action_gst_form" model="ir.actions.act_window">
        <field name="name">GST Forms</field>
        <field name="res_model">gst.form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gst_form" name="GST Forms" parent="purchase.menu_purchase_root" action="action_gst_form"/>
</odoo>