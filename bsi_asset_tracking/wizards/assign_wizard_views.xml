<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_assign_wizard_form" model="ir.ui.view">
        <field name="name">asset.assign.wizard.form</field>
        <field name="model">asset.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assignment">
                <group>
                    <field name="employee_id"/>
                    <field name="location"/>
                    <field name="asset_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Assign" name="action_assign" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Assets</field>
        <field name="res_model">asset.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_asset_asset"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>