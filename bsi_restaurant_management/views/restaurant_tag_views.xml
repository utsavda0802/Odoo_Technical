<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_tag_list_view" model="ir.ui.view">
        <field name="name">restaurant.tag.list</field>
        <field name="model">restaurant.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="restaurant_tag_form_view" model="ir.ui.view">
        <field name="name">restaurant.tag.form</field>
        <field name="model">restaurant.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
