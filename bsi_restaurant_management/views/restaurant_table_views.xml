<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_table_list_view" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
                <field name="is_available" widget= "boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="restaurant_table_form_view" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="is_available" widget= "boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>


