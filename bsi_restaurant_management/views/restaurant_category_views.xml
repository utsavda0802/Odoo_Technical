<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_category_list_view" model="ir.ui.view">
        <field name="name">restaurant.category.list</field>
        <field name="model">restaurant.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="restaurant_category_form_view" model="ir.ui.view">
        <field name="name">restaurant.category.form</field>
        <field name="model">restaurant.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
