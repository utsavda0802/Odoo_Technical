<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions -->

    <record id="action_restaurant_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_restaurant_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">restaurant.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_restaurant_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">restaurant.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_restaurant_menu" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">restaurant.menu</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_restaurant_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">restaurant.customer</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_restaurant_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">kanban,list,form,graph,pivot,calendar,activity</field>
    </record>

    <!-- Menus -->

    <menuitem
        id="restaurant_root_menu"
        name="Restaurant Management"
        sequence="1"/>

    <menuitem
        id="restaurant_master_menu"
        name="Masters"
        parent="restaurant_root_menu"
        sequence="1"/>

    <menuitem
        id="restaurant_orders_menu"
        name="Orders"
        parent="restaurant_root_menu"
        sequence="2"/>

    <menuitem
        id="restaurant_table_menu"
        name="Tables"
        parent="restaurant_master_menu"
        action="action_restaurant_table"/>

    <menuitem
        id="restaurant_category_menu"
        name="Categories"
        parent="restaurant_master_menu"
        action="action_restaurant_category"/>

    <menuitem
        id="restaurant_tag_menu"
        name="Tags"
        parent="restaurant_master_menu"
        action="action_restaurant_tag"/>

    <menuitem
        id="restaurant_menu_menu"
        name="Menu Items"
        parent="restaurant_master_menu"
        action="action_restaurant_menu"/>

    <menuitem
        id="restaurant_customer_menu"
        name="Customers"
        parent="restaurant_master_menu"
        action="action_restaurant_customer"/>

    <menuitem
        id="restaurant_order_menu"
        name="Customer Orders"
        parent="restaurant_orders_menu"
        action="action_restaurant_order"/>

</odoo>