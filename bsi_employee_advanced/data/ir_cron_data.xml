<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_anniversary_review" model="ir.cron">
        <field name="name">Employee Anniversary Review</field>
        <field name="model_id" ref="model_test_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_anniversary_review()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_confirm_probation" model="ir.cron">
        <field name="name">Employee confirm after 90 days</field>
        <field name="model_id" ref="model_test_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_confirm_probation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

</odoo>