<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_test_employee" model="ir.actions.report">
        <field name="name">Employee Report</field>
        <field name="model">test.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bsi_employee_advanced.report_test_employee</field>
        <field name="report_file">bsi_employee_advanced.report_test_employee</field>
        <field name="binding_model_id" ref="model_test_employee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_test_employee">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Employee Report</h2>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Department</th>
                                <th class="text-end">Salary</th>
                                <th class="text-end">Annual Salary</th>
                                <th class="text-end">Bonus</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="emp">
                                <tr>
                                    <td><span t-field="emp.name"/></td>
                                    <td><span t-field="emp.department_id"/></td>
                                    <td class="text-end"><span t-field="emp.salary"/></td>
                                    <td class="text-end"><span t-field="emp.annual_salary"/></td>
                                    <td class="text-end"><span t-field="emp.bonus"/></td>
                                    <td><span t-field="emp.status"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>