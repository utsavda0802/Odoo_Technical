<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<record id="view_car_vehicle_list" model="ir.ui.view">
		<field name="name">car.vehicle.list</field>
		<field name="model">car.vehicle</field>
		<field name="arch" type="xml">
			<list>
				<field name="license_plate"/>
				<field name="make"/>
				<field name="model"/>
				<field name="customer_id"/>
			</list>
		</field>
	</record>

	<record id="view_car_vehicle_form" model="ir.ui.view">
		<field name="name">car.vehicle.form</field>
		<field name="model">car.vehicle</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_button_box">
						<button name="action_view_jobs" type="object" string="View Jobs">
							<field name="job_count"/>
						</button>
					</div>
					<group>
						<field name="customer_id"/>
						<field name="license_plate"/>
						<field name="make"/>
						<field name="model"/>
						<field name="year"/>
					</group>
					<notebook>
						<page string="Service History">
							<field name="job_ids">
								<list>
									<field name="name"/>
									<field name="arrival_date"/>
									<field name="mechanic_id"/>
									<field name="state"/>
									<field name="total_amount"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_car_vehicle" model="ir.actions.act_window">
			<field name="name">Vehicles</field>
			<field name="res_model">car.vehicle</field>
			<field name="view_mode">list,form</field>
	</record>
</odoo>