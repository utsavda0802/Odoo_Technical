<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<record id="view_car_customer_list" model="ir.ui.view">
		<field name="name">car.customer.list</field>
		<field name="model">car.customer</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="phone"/>
				<field name="email"/>
			</list>
		</field>
	</record>

	<record id="view_car_customer_form" model="ir.ui.view">
		<field name="name">car.customer.form</field>
		<field name="model">car.customer</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="phone"/>
						<field name="email"/>
					</group>
					<notebook>
						<page string="Vehicles">
							<field name = "vehicle_ids">
								<list>
									<field name="license_plate"/>
									<field name="make"/>
									<field name="model"/>
									<field name="year"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_car_customer" model="ir.actions.act_window">
		<field name="name">Customer</field>
		<field name="res_model">car.customer</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>