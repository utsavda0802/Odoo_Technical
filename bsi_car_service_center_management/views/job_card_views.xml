<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<record id="view_job_card_list" model="ir.ui.view">
	    <field name="name">job.card.list</field>
	    <field name="model">job.card</field>
	    <field name="arch" type="xml">
	        <list>
	            <header>
	                <button name="action_open_bulk_close_wizard" type="object" string="Create Invoices" class="btn-primary"/>
	            </header>
	            <field name="name"/>
	            <field name="customer_id"/>
	            <field name="vehicle_id"/>
	            <field name="mechanic_id"/>
	            <field name="arrival_date"/>
	            <field name="expected_delivery_date"/>
	            <field name="is_priority"/>
	            <field name="state"/>
	            <field name="total_amount"/>
	            <field name="balance_due"/>
	        </list>
	    </field>
	</record>

	<record id="view_job_card_form" model="ir.ui.view">
		<field name="name">job.card.form</field>
		<field name="model">job.card</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_set_in_progress" string="Start Job" type="object" invisible="state != 'new'" class="oe_highlight"/>
					<button name="action_set_waiting_parts" string="Waiting for parts" type="object" invisible="state != 'in_progress'"/>
					<button name="action_set_completed" string="Mark Completed" type="object" invisible="state not in ('in_progress','waiting_parts')" class="oe_highlight"/>
					<button name="action_set_delivered" string="Mark Delivered" type="object" invisible="state != 'completed'" class="oe_highlight"/>
					<button name="action_open_payment_wizard" string="Register Payment" type="object" invisible="balance_due &lt;= 0" class="oe_highlight"/>
					<button type="action" name="%(action_report_job_card)d" string="Print Job Card" class="btn-secondary"/>
					<button name="action_create_invoice" string="Create Invoice" type="object" invisible="state != 'completed'" class="oe_highlight"/>
					<field name="state" widget="statusbar" statusbar_visible="new,in_progress,waiting_parts,completed,delivered"/>
				</header>
				<sheet>
					<div class="oe-title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="customer_id"/>
							<field name="vehicle_id" domain="[('customer_id', '=', customer_id)]"/>
							<field name="mechanic_id"/>
							<field name="job_type_ids" widget="many2many_tags"/>
						</group>
						<group>
							<field name="arrival_date"/>
							<field name="expected_delivery_date"/>
							<field name="is_priority"/>
						</group>
					</group>
					<notebook>
						<page string="Problem Description">
							<field name="problem_description"/>
						</page>
						<page string="Arrival Photos">
							<field name="photo_ids" widget="many2many_binary"/>
						</page>

						<page string="Parts &amp; Labor">
							<field name="part_line_ids">
								<list editable="bottom">
									<field name="part_id"/>
									<field name="quantity"/>
									<field name="unit_price"/>
									<field name="subtotal" readonly="1"/>
								</list>
							</field>
							<group class = "oe_subtotal_footer">
								<field name="labor_charges"/>
								<field name="parts_total" readonly="1"/>
								<field name="discount_percent"/>
								<field name="total_amount" readonly="1"/>
							</group>
						</page>
						<page string="Payment">
							<group>
								<field name="advance_paid" readonly="1"/>
								<field name="balance_due" readonly="1"/>
								<field name="invoice_number" readonly="1"/>
								<field name="invoice_generated" readonly="1"/>
							</group>
							<field name="payment_ids">
								<list editable="bottom" create="0">
									<field name="payment_date"/>
									<field name="amount"/>
									<field name="payment_method"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_job_card_graph" model="ir.ui.view">
		<field name="name">job.card.graph</field>
		<field name="model">job.card</field>
		<field name="arch" type="xml">
			<graph string="Revenue">
				<field name="mechanic_id" type="row"/>
				<field name="total_amount" type="measure"/>
			</graph>
		</field>
	</record>

	<record id="view_job_card_pivot" model="ir.ui.view">
		<field name="name">job.card.pivot</field>
		<field name="model">job.card</field>
		<field name="arch" type="xml">
			<pivot string="Revenue Analysis">
				<field name="mechanic_id" type="row"/>
				<field name="arrival_date" interval="month" type="col"/>
				<field name="total_amount" type="measure"/>
			</pivot>
		</field>
	</record>

	<record id="view_job_card_kanban" model="ir.ui.view">
		<field name="name">job.card.kanban</field>
		<field name="model">job.card</field>
		<field name="arch" type="xml">
			<kanban default_group_by="state" records_draggable="1">
				<field name="name"/>
				<field name="customer_id"/>
				<field name="vehicle_id"/>
				<field name="mechanic_id"/>
				<field name="is_priority"/>
				<field name="total_amount"/>
				<templates>
					<t t-name="card">
						<div class="oe_kanban_global_click">
							<strong><field name="name"/></strong>
							<span t-if="record.is_priority.raw_value" class="badge text-bg-danger">
    							Rush
							</span>
							<div><field name="customer_id"/>-<field name="vehicle_id"/></div>
							<div>Mechanic: <field name="mechanic_id"/></div>
							<div>Total: <field name="total_amount"/></div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_job_card_search" model="ir.ui.view">
		<field name="name">job.card.search</field>
		<field name="model">job.card</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="customer_id"/>
				<field name="vehicle_id"/>
				<field name="mechanic_id"/>
				<field name="state"/>
				<field name="is_priority"/>
				<field name="arrival_date"/>
				<filter name="group_state" string="Status" context="{'group_by':'state'}"/>
				<filter name="group_mechanic" string="Mechanic" context="{'group_by':'mechanic_id'}"/>
				<filter name="group_month" string="Arrival Month" context="{'group_by':'arrival_date:month'}"/>
			</search>
		</field>
	</record>

	<record id="action_job_card" model="ir.actions.act_window">
		<field name="name">Job Cards</field>
		<field name="res_model">job.card</field>
		<field name="view_mode">list,form,kanban,graph,pivot</field>
		<field name="search_view_id" ref="view_job_card_search"/>
	</record>

</odoo>