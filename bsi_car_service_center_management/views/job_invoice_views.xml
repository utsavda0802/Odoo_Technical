<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<record id="view_job_invoice_form" model="ir.ui.view">
	    <field name="name">job.invoice.form</field>
	    <field name="model">job.invoice</field>
	    <field name="arch" type="xml">
	        <form>
	            <header>
	                <button name="action_post" string="Post" type="object" invisible="state != 'new'" class="oe_highlight"/>
					<field name="state" widget="statusbar" statusbar_visible="new,posted"/>
	            </header>
	            <sheet>
					<div class="oe-title">
						<h1><field name="name" placeholder="e.g. INV-101"/></h1>
					</div>
					<group>
						<group>
							<field name="job_id" readonly="1"/>
							<field name="customer_id" readonly="1"/>
							<field name='vehicle_id' readonly="1"/>
							<field name='mechanic_id' readonly="1"/>
							<field name='job_type_ids' widget="many2many_tags" readonly="1"/>
						</group>
						<group>
							<field name="arrival_date" readonly="1"/>
							<field name="expected_delivery_date" readonly="1"/>
							<field name="is_priority" readonly="1"/>
							<field name="invoice_date" readonly="1"/>
						</group>
					</group>
					<notebook>
						<page string="Parts &amp; Labor">
							<field name="line_ids" readonly="state == 'posted'">
							    <list editable="bottom">
							        <field name="part_id"/>
							        <field name="quantity"/>
							        <field name="unit_price"/>
							        <field name="subtotal" readonly="1"/>
							    </list>
							</field>
							<group class="oe_subtotal_footer">
							    <field name="labor_charges" readonly="state == 'posted'"/>
							    <field name="parts_total" readonly="1"/>
							    <field name="discount_percent" readonly="state == 'posted'"/>
							    <field name="total" readonly="1"/>
							</group>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_job_invoice_list" model="ir.ui.view">
	    <field name="name">job.invoice.list</field>
	    <field name="model">job.invoice</field>
	    <field name="arch" type="xml">
	        <list>
	        	<field name="name"/>
	        	<field name="job_id"/>
	            <field name="customer_id"/>
	            <field name="total"/>
	            <field name="state"/> 
	        </list>
	    </field>
	</record>

	<record id="action_job_invoice" model="ir.actions.act_window">
	    <field name="name">Invoices</field>
	    <field name="res_model">job.invoice</field>
	    <field name="view_mode">list,form</field>
	</record>
</odoo>