<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<record id="view_car_customer_list" model="ir.ui.view">
		<field name="name">car.mechanic.list</field>
		<field name="model">car.mechanic</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="on_leave"/>
				<field name="active_job_count"/>
			</list>
		</field>
	</record>

	<record id="view_car_mechanic_form" model="ir.ui.view">
		<field name="name">car.mechanic.form</field>
		<field name="model">car.mechanic</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="on_leave"/>
						<field name="active_job_count"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_car_mechanic" model="ir.actions.act_window">
		<field name="name">Mechanics</field>
		<field name="res_model">car.mechanic</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>
