<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bsi_subject_list" model="ir.ui.view">
        <field name="name">bsi.subject.list</field>
        <field name="model">bsi.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_bsi_subject_form" model="ir.ui.view">
        <field name="name">bsi.subject.form</field>
        <field name="model">bsi.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bsi_subject_search" model="ir.ui.view">
        <field name="name">bsi.subject.search</field>
        <field name="model">bsi.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_bsi_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">bsi.subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>