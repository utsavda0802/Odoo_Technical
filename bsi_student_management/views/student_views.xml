<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_bsi_student_list" model="ir.ui.view">
        <field name="name">bsi.student.list</field>
        <field name="model">bsi.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="student_code"/>
                <field name="name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="email"/>
                <field name="course_id"/>
                <field name="joining_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bsi_student_form" model="ir.ui.view">
        <field name="name">bsi.student.form</field>
        <field name="model">bsi.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>

                    <group>
                        <group>
                            <field name="student_code" readonly="1"/>
                            <field name="name"/>
                            <field name="age"/>
                            <field name="gender"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="joining_date"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="course_id"/>
                        <field name="subject_ids" widget="many2many_tags"/>
                        <field name="attendance_count" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Attendance">
                            <field name="attendance_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bsi_student_search" model="ir.ui.view">
        <field name="name">bsi.student.search</field>
        <field name="model">bsi.student</field>
        <field name="arch" type="xml">
            <search>

                <field name="student_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="course_id"/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <group>
                    <filter
                        name="group_course"
                        string="Course"
                        context="{'group_by':'course_id'}"/>

                    <filter
                        name="group_gender"
                        string="Gender"
                        context="{'group_by':'gender'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bsi_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">bsi.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bsi_student_search"/>
    </record>

</odoo>