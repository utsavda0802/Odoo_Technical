<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bsi_course_list" model="ir.ui.view">
        <field name="name">bsi.course.list</field>
        <field name="model">bsi.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="duration"/>
                <field name="fees"/>
            </list>
        </field>
    </record>

    <record id="view_bsi_course_form" model="ir.ui.view">
        <field name="name">bsi.course.form</field>
        <field name="model">bsi.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="duration"/>
                        <field name="fees"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bsi_course_search" model="ir.ui.view">
        <field name="name">bsi.course.search</field>
        <field name="model">bsi.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_bsi_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">bsi.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>