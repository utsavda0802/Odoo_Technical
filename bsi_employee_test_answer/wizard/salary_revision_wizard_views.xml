<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bsi_salary_revision_wizard_form" model="ir.ui.view">
        <field name="name">bsi.salary.revision.wizard.form</field>
        <field name="model">bsi.salary.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Revision">
                <group>
                    <field name="percentage"/>
                </group>
                <group>
                    <field name="updated_count" readonly="1"/>
                    <field name="skipped_count" readonly="1"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bsi_salary_revision_wizard" model="ir.actions.act_window">
        <field name="name">Salary Revision</field>
        <field name="res_model">bsi.salary.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_bsi_employee"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>