<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bsi_employee_department_list" model="ir.ui.view">
        <field name="name">bsi.employee.department.list</field>
        <field name="model">bsi.employee.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="employee_count"/>
            </list>
        </field>
    </record>
    <record id="view_bsi_employee_department_form" model="ir.ui.view">
        <field name="name">bsi.employee.department.form</field>
        <field name="model">bsi.employee.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <div class="oe_button_box">
                            <button type="object" name="action_open_employees" class="oe_stat_button" icon="fa-users">
                                <field name="employee_count" widget="statinfo" string="Employees"/>
                            </button>
                        </div>
                    </header>    
                    <group>
                        <field name="name"/>
                        <field name="manager_id"/>
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids">
                                <list>
                                    <field name="employee_code"/>
                                    <field name="name"/>
                                    <field name="designation"/>
                                    <field name="basic_salary"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bsi_employee_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">bsi.employee.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_bsi_employee_department"
        name="Departments"
        parent="menu_bsi_employee_root"
        action="action_bsi_employee_department"
        sequence="20"
    />

</odoo>