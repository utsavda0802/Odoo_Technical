<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_training_replace_wizard_form" model="ir.ui.view">
        <field name="name">training.replace.wizard.form</field>
        <field name="model">training.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Students">
                <group>
                    <field name="course_id" readonly="1"/>
                    <field name="student_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_replace" string="Replace" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_training_replace_wizard" model="ir.actions.act_window">
        <field name="name">Replace Students</field>
        <field name="res_model">training.replace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
