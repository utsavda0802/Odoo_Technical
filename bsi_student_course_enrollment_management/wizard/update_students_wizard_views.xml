<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- ===== Update students (Requirement 2) ===== -->
    <record id="view_training_update_students_wizard_form" model="ir.ui.view">
        <field name="name">training.update.students.wizard.form</field>
        <field name="model">training.update.students.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Students">
                <group>
                    <field name="course_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="student_id" readonly="1"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="age"/>
                    </list>
                </field>
                <footer>
                    <button name="action_update" string="Update" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_training_update_students_wizard" model="ir.actions.act_window">
        <field name="name">Update Students</field>
        <field name="res_model">training.update.students.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>  
</odoo>