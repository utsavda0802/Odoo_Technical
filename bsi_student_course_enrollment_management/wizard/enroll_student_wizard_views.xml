<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_enroll_student_wizard_form" model="ir.ui.view">
        <field name="name">training.enroll.student.wizard.form</field>
        <field name="model">training.enroll.student.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="course_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="email"/>
                        <field name="age"/>
                    </list>
                </field>
                <footer>
                    <button string="Enroll" name="action_enroll" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

