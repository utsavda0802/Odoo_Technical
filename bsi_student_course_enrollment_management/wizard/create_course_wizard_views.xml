<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ===== Create course (Requirement 1 + 8) ===== -->
    <record id="view_training_create_course_wizard_form" model="ir.ui.view">
        <field name="name">training.create.course.wizard.form</field>
        <field name="model">training.create.course.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Course">
                <group>
                    <field name="name"/>
                    <field name="course_fee"/>
                    <field name="description"/>
                </group>
                <notebook>
                    <page string="New Students">
                        <field name="student_line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="email"/>
                                <field name="age"/>
                            </list>
                        </field>
                    </page>
                    <page string="Sessions">
                        <field name="session_line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="session_date"/>
                                <field name="instructor"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create" string="Create Course" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_training_create_course_wizard" model="ir.actions.act_window">
        <field name="name">Create Course</field>
        <field name="res_model">training.create.course.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>