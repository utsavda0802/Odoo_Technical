<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_training_course_list" model="ir.ui.view">
        <field name="name">training.course.list</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_fee"/>
            </list>
        </field>
    </record>

    <record id="view_training_course_form" model="ir.ui.view">
        <field name="name">training.course.form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_training_update_students_wizard)d" string="Update Students" type="action"/>
                    <button name="%(action_training_manage_sessions_wizard)d" string="Manage Sessions" type="action"/>
                    <button name="action_remove_first_student" string="Remove First Student" type="object"/>
                    <button name="action_delete_last_student" string="Delete Last Student" type="object"/>
                    <button name="action_clear_students" string="Clear Students" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="course_fee"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids" options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="age"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sessions">
                            <field name="session_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="session_date"/>
                                    <field name="instructor"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>