<odoo>
    <record id="view_rental_return_wizard_form" model="ir.ui.view">
        <field name="name">rental.return.wizard.form</field>
        <field name="model">rental.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Equipment">
                <group>
                    <field name="rental_id" readonly="1"/>
                    <field name="return_date"/>
                    <field name="condition"/>
                    <field name="damage_note"/>
                </group>
                <footer>
                    <button name="action_confirm_return" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>