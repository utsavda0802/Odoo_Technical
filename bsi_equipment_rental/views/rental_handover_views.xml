<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_handover_list" model="ir.ui.view">
        <field name="name">rental.handover.list</field>
        <field name="model">rental.handover</field>
        <field name="arch" type="xml">
            <list string="Handovers">
                <field name="rental_id"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="handover_date"/>
            </list>
        </field>
    </record>

    <record id="action_rental_handover" model="ir.actions.act_window">
        <field name="name">Handovers</field>
        <field name="res_model">rental.handover</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>