<odoo>
    <record id="view_rental_order_list" model="ir.ui.view">
        <field name="name">rental.order.list</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <list string="Rental Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="return_date"/>
                <field name="state" decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'returned'"/>
                <!-- Req 6: sum="Total" makes it show a grouped/summed total in list footer -->
                <field name="total_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_rental_order_form" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_returned" string="Mark Returned" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <!-- Req 1: domain restricts dropdown to customers only -->
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="rental_days"/>
                            <field name="return_date"/>
                            <field name="urgent_delivery"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rental Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <!-- Req 2: domain restricts to Available equipment only -->
                                    <field name="equipment_id"/>
                                    <field name="quantity"/>
                                    <field name="price_per_day"/>
                                    <field name="days" readonly="1"/>
                                    <!-- Req 5: amount is computed, never typed -->
                                    <field name="amount" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer oe_right">
                        <field name="discount"/>
                        <field name="express_charge" readonly="1" invisible="not urgent_delivery"/>
                        <field name="total_amount" readonly="1"/>
                    </group>
                </sheet>

                <!-- Req 11: chatter shows the status-change history log automatically
                     because state has tracking=True and the model inherits mail.thread -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_order_search" model="ir.ui.view">
        <field name="name">rental.order.search</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <search string="Rental Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_amount"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <separator/>
                <group>
                    <filter string="Customer" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_order_search"/>
    </record>
</odoo>