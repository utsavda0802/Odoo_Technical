<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_order_list" model="ir.ui.view">
        <field name="name">rental.order.list</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <list string="Rental Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="return_date"/>
                <field name="state"/>
                <field name="total_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_rental_order_form" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"/>
                    <button name="action_open_return_wizard" string="Return Equipment" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="rental_days"/>
                            <field name="return_date"/>
                            <field name="urgent_delivery"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rental Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="quantity"/>
                                    <field name="price_per_day"/>
                                    <field name="days"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="discount"/>
                        <field name="total_amount"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_order_search" model="ir.ui.view">
        <field name="name">rental.order.search</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <search string="Rental Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_amount"/>
                <group>
                    <filter string="Customer" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_order_search"/>
    </record>
</odoo>

