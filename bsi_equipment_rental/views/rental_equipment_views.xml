<odoo>
    <record id="view_rental_equipment_list" model="ir.ui.view">
        <field name="name">rental.equipment.list</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="status" decoration-success="status == 'available'"
                       decoration-danger="status == 'rented'"
                       decoration-warning="status == 'maintenance'"/>
                <field name="price_per_day"/>
                <field name="security_deposit"/>
            </list>
        </field>
    </record>

    <record id="view_rental_equipment_form" model="ir.ui.view">
        <field name="name">rental.equipment.form</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <widget name="web_ribbon" title="Rented" bg_color="text-bg-danger"
                            invisible="status != 'rented'"/>
                    <widget name="web_ribbon" title="Maintenance" bg_color="text-bg-warning"
                            invisible="status != 'maintenance'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="price_per_day"/>
                            <field name="security_deposit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">rental.equipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>