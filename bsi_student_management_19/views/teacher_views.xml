<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_bsi_teacher_list" model="ir.ui.view">
        <field name="name">bsi.teacher.list</field>
        <field name="model">bsi.teacher</field>
        <field name="arch" type="xml">
            <list string="Teacher">
                <field name="name"/>
                <field name="exp"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bsi_teacher_form" model="ir.ui.view">
        <field name="name">bsi.teacher.form</field>
        <field name="model">bsi.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="exp"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_bsi_teacher" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">bsi.teacher</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Student Menu -->
    <menuitem
        id="menu_teacher"
        name="Teacher"
        parent="menu_student_root"
        action="action_bsi_teacher"
        sequence="1"/>


</odoo>