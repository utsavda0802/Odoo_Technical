<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_bsi_std_list" model="ir.ui.view">
        <field name="name">bsi.std.list</field>
        <field name="model">bsi.std</field>
        <field name="arch" type="xml">
            <list string="Standard">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bsi_std_form" model="ir.ui.view">
        <field name="name">bsi.std.form</field>
        <field name="model">bsi.std</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_ids">
                            <list>
                                <field name="name" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_bsi_standard" model="ir.actions.act_window">
        <field name="name">Standard</field>
        <field name="res_model">bsi.std</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Student Menu -->
    <menuitem
        id="menu_standard"
        name="Standard"
        parent="menu_student_root"
        action="action_bsi_standard"
        sequence="1"/>


</odoo>