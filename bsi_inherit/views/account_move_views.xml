<odoo>
	<record id="view_move_form_inherit_custom" model="ir.ui.view">
		<field name="name">account.move.form.inherit.custom</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='currency_id']" position="after">
				<field name="custom_name"/>
			</xpath>
			<xpath expr="//field[@name='invoice_line_ids']//list[@name='journal_items']//field[@name='price_unit']" position="after">
				<field name="custom_weight"/>
			</xpath>
		</field>
	</record>
</odoo>