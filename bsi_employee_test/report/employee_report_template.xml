<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_employee_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1>Employee Details <span t-field="o.name"/></h1>

                        <table class="table table-sm mt-3">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Employee Code</th>
                                    <th>Date of Birth</th>
                                    <th>Joining Date</th>
                                    <th>Designation</th>
                                    <th>Department</th>
                                    <th>Basic Salary</th>
                                    <th>Status</th>
                                    <th>Annual Salary</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.employee" t-as="emp">
                                    <td><span t-field="emp.name"/></td>
                                    <td><span t-field="emp.employee_code"/></td>
                                    <td><span t-field="emp.date_of_birth"/></td>
                                    <td><span t-field="emp.joining_date"/></td>
                                    <td><span t-field="emp.designation"/></td>
                                    <td><span t-field="emp.department"/></td>
                                    <td><span t-field="emp.basic_salary"/></td>
                                    <td><span t-field="emp.status"/></td>
                                    <td><span t-field="emp.annual_salary"/></td>
                                    <td><span t-field="emp.bonus"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>