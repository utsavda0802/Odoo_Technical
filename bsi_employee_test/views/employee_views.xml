<odoo>
    <record id="view_employee_list" model="ir.ui.view">
        <field name="name">employee.list</field>
        <field name="model">employee</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_increase_salary_wizard" type="object" string="Increase Salary" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="employee_code"/>
                <field name="designation"/>
                <field name="joining_date"/>
                <field name="department"/>
            </list>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">employee.form</field>
        <field name="model">employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_code"/>
                        <field name="date_of_birth"/>
                        <field name="designation"/>
                        <field name="department"/>
                    </group>
                    <group>
                        <field name="joining_date"/>
                        <field name="department"/>
                        <field name="basic_salary"/>
                        <field name="annual_salary"/>
                        <field name="bonus"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">employee</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>